// Cloudflare Workers: on every push Workers Builds runs the build (tools/build_dist.mjs), which puts only the game in
// dist/ with its scripts minified and its pictures masked (.pak, unmasked in the browser by sw.js), then deploys dist/.
// The repository keeps the readable originals.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lao-multy",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "build": { "command": "node tools/build_dist.mjs" },
  "assets": { "directory": "./dist" }
}
